# PostgreSQL - Desenvolvimento local
DATABASE_URL=postgresql+psycopg://logos:logos_dev@localhost:5435/logos_db

# PostgreSQL - Testes automatizados
TEST_DATABASE_URL=postgresql+psycopg://logos:logos_dev@localhost:5435/logos_test

# Autenticação JWT
JWT_SECRET_KEY=substitua_por_uma_chave_aleatoria_segura
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookies
# false somente para desenvolvimento local usando HTTP.
# Em produção, utilizar true com HTTPS.
COOKIE_SECURE=false

# Origem autorizada para acessar a API.
CORS_ORIGINS=http://localhost:5173

# Dados de demonstração
# Habilitar explicitamente apenas no ambiente de demonstração.
DEMO_SEED_ENABLED=true

# Nome exato do banco autorizado para receber o seed
DEMO_DATABASE_NAME=logos_db